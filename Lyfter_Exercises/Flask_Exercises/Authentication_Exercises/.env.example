APP_ENV=development
DB_SCHEMA=authentication_exercises  #This is optional, in my case I want to name it "orm_exercises"
DATABASE_URL=my_local_db_url
TEST_DATABASE_URL=my_local_db_url_for_testing
SECRET_KEY=my_api_secret_key
LOG_LEVEL=INFO   # We use DEBUG when we need more detail

JWT_SECRET_KEY=my_secret_key  # run this to generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS= 7