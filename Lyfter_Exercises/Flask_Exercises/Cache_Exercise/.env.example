APP_ENV=development
DB_SCHEMA=cache_exercise
DATABASE_URL=my_local_db_url
TEST_DATABASE_URL=my_local_db_url_for_testing
SECRET_KEY=my_api_secret_key
LOG_LEVEL=INFO   # We use DEBUG when we need more detail

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS= 7

#Redis Cache
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1